{
  "rules": {
    ".read": false,
    ".write": false,

    "preReleaseEvent": {

      "config": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.admin === true"
      },

      "participants": {
        ".read": "auth != null",
        ".write": "auth != null"
      },

      "rankings": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}

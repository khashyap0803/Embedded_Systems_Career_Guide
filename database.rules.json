{
  "rules": {
    ".read": false,
    ".write": false,

    "preReleaseEvent": {

      "config": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.admin === true"
      },

      "participants": {
        ".read": "auth != null && (auth.token.admin === true || auth.token.email === 'exam1234@challenge.app')",
        ".write": "auth != null && (auth.token.admin === true || auth.token.email === 'exam1234@challenge.app')"
      },

      "rankings": {
        ".read": "auth != null && (auth.token.admin === true || auth.token.email === 'exam1234@challenge.app')",
        ".write": "auth != null && (auth.token.admin === true || auth.token.email === 'exam1234@challenge.app')"
      }
    }
  }
}

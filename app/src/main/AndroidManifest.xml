<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Runtime-requested on API 33+ when the user turns on the Settings > Daily Reminder toggle. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-arms the reminder alarm after a reboot, since AlarmManager alarms don't survive one. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- ReportViewerActivity.downloadReport() only requests this below API 29 (scoped
         storage / MediaStore handles it above that) - without a manifest declaration
         the runtime request is denied immediately with no dialog on API 26-28. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Package-visibility (API 30+): without this, SpeechRecognizer.isRecognitionAvailable()
         can return false even when a recognizer is installed, since queryIntentActivities()
         is filtered unless the target package is declared here. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".EsCareerGuideApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EmbeddedSystemsCareerGuide"
        tools:targetApi="31">

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.EmbeddedSystemsCareerGuide">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.introduction.IntroductionActivity"
            android:exported="false"
            android:theme="@style/Theme.EmbeddedSystemsCareerGuide" />

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true" />

        <activity
            android:name=".ui.assessment.AssessmentActivity"
            android:configChanges="uiMode"
            android:exported="false" />

        <activity
            android:name=".ui.assessment.ReportViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.EmbeddedSystemsCareerGuide" />

        <activity
            android:name=".ui.quiz.QuizActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:theme="@style/Theme.EmbeddedSystemsCareerGuide" />

        <!-- V2: Content Reading Activity for Kindle-style learning -->
        <activity
            android:name=".ui.content.ContentReadingActivity"
            android:exported="false"
            android:theme="@style/Theme.EmbeddedSystemsCareerGuide" />

        <!-- Practice tab: flashcards / interview prep / project challenges -->
        <activity
            android:name=".ui.practice.PracticeContentActivity"
            android:exported="false"
            android:theme="@style/Theme.EmbeddedSystemsCareerGuide" />

        <!-- Pre-Release Event Challenge Activities -->
        <activity
            android:name=".ui.challenge.ChallengeLoginActivity"
            android:exported="false"
            android:theme="@style/Theme.EmbeddedSystemsCareerGuide" />

        <activity
            android:name=".ui.challenge.RollNumberEntryActivity"
            android:exported="false"
            android:theme="@style/Theme.EmbeddedSystemsCareerGuide" />

        <activity
            android:name=".ui.challenge.Challenge1Activity"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EmbeddedSystemsCareerGuide" />

        <activity
            android:name=".ui.challenge.Challenge2Activity"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EmbeddedSystemsCareerGuide" />

        <activity
            android:name=".ui.challenge.Challenge3Activity"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EmbeddedSystemsCareerGuide" />

        <activity
            android:name=".ui.challenge.RankingDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.EmbeddedSystemsCareerGuide" />

        <activity
            android:name=".ui.challenge.AdminDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.EmbeddedSystemsCareerGuide" />

        <!-- Daily practice reminder (Settings > Daily Reminder toggle) -->
        <receiver
            android:name=".services.DailyReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".services.BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
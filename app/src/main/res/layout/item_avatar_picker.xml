<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_avatar_option"
    android:layout_width="64dp"
    android:layout_height="64dp"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/slate_700"
    app:cardCornerRadius="32dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/cyan_400"
    app:strokeWidth="0dp">

    <ImageView
        android:id="@+id/image_avatar_option"
        android:contentDescription="@string/cd_avatar_option"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="6dp"
        android:scaleType="centerInside"
        tools:src="@drawable/avatar_1" />

</com.google.android.material.card.MaterialCardView>

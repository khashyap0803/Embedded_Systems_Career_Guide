<?xml version="1.0" encoding="utf-8"?>
<!--
  The DrawerLayout/NavigationView that used to wrap this content has been
  removed. Its menu (@menu/navigation_drawer) was an empty <menu> with no
  items and MainActivity never wired a hamburger to it, but DrawerLayout
  still responded to left-edge swipes - so an accidental swipe slid a blank
  white panel over the app with no visible way to dismiss it. Nothing in
  code referenced drawer_layout or nav_view.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data />

    <FrameLayout
        android:id="@+id/activity_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <include
            android:id="@+id/appBarMain"
            layout="@layout/app_bar_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>
</layout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textFieldForgotEmail"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email Address"
        app:boxBackgroundColor="?attr/appInputBackground"
        app:boxStrokeColor="@color/indigo_500"
        app:hintTextColor="?attr/appTextHint"
        app:startIconDrawable="@drawable/ic_email"
        app:startIconTint="?attr/appTextSecondary"
        app:errorEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextForgotEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:textColor="?attr/appTextPrimary"
            android:textColorHint="?attr/appTextHint" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="We'll send a password reset link to this email if an account exists."
        android:textColor="?attr/appTextSecondary"
        android:textSize="12sp" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  User-selectable themes.

  Each supplies the full semantic palette (the app* attributes from attrs.xml)
  plus the Material3 colour roles, so switching repaints every screen without
  touching a layout. Adding a theme means a style here and one entry in
  AppTheme - nothing else.

  Contrast targets, chosen because the first cut of these palettes looked
  washed out. The original design drew cards as a 10%-alpha slate over a navy
  background, which composites to roughly #131A2C - far darker than the
  opaque #1E293B that replaced it, so cards drifted toward the background and
  text lost its edge.

    - surfaces sit only 3-6% above their background, keeping the deep,
      high-contrast base the app was designed around
    - primary text is at or near pure white (>= 15:1 on its surface), which is
      what reads as "sharp"
    - secondary text stays >= 7:1 rather than the ~4.5:1 it had been
    - outlines and accents stay saturated so the UI reads colourful rather
      than dusty
-->
<resources>

    <!-- ============ Midnight (default) - deep navy ============ -->
    <style name="Theme.App.Midnight" parent="Theme.EmbeddedSystemsCareerGuide">
        <item name="appBackground">#0B1120</item>
        <item name="appSurface">#131C31</item>
        <item name="appSurfaceElevated">#1B2742</item>
        <item name="appOutline">#31415C</item>
        <item name="appInputBackground">#1B2742</item>
        <item name="appTextPrimary">#FFFFFF</item>
        <item name="appTextSecondary">#B4C3DA</item>
        <item name="appTextTertiary">#8C9DB8</item>
        <item name="appTextHint">#7B8CA8</item>
        <item name="appAccentMuted">#2E6366F1</item>
        <item name="appWindowBackground">@drawable/bg_window_midnight</item>

        <item name="colorPrimary">#818CF8</item>
        <item name="colorOnPrimary">#0B1120</item>
        <item name="colorSecondary">#22D3EE</item>
        <item name="colorOnSecondary">#0B1120</item>
        <item name="android:colorBackground">#0B1120</item>
        <item name="colorSurface">#131C31</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnBackground">#FFFFFF</item>
        <item name="colorSurfaceVariant">#1B2742</item>
        <item name="colorOnSurfaceVariant">#B4C3DA</item>
        <item name="colorOutline">#31415C</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B4C3DA</item>
        <item name="android:statusBarColor">#0B1120</item>
        <item name="android:navigationBarColor">#0B1120</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>


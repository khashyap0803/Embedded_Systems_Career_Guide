<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Base theme, shared by both modes.

      Colour roles resolve through the semantic names, which flip between
      values/colors.xml (light) and values-night/colors.xml (dark). This block
      used to hardcode dark swatches while inheriting Material3.DayNight, so
      in day mode the ~8 roles named here were dark while every role it did
      NOT name kept Material3's light defaults - producing light-on-light
      chips, dialog containers, outlined field strokes and switch tracks.

      windowLightStatusBar/-NavigationBar are true here (dark icons for the
      light background) and overridden to false in values-night.
    -->
    <style name="Theme.EmbeddedSystemsCareerGuide" parent="Theme.Material3.DayNight.NoActionBar">
        <!--
          Defaults for the semantic palette. Every user-selectable theme in
          themes_palettes.xml overrides all of these; they exist so the base
          theme is still fully resolvable on its own (an unresolved ?attr is an
          inflation crash, not a fallback).
        -->
        <item name="appBackground">@color/background</item>
        <item name="appSurface">@color/card_background</item>
        <item name="appSurfaceElevated">@color/card_elevated</item>
        <item name="appOutline">@color/card_border</item>
        <item name="appInputBackground">@color/input_background</item>
        <item name="appTextPrimary">@color/text_primary</item>
        <item name="appTextSecondary">@color/text_secondary</item>
        <item name="appTextTertiary">@color/text_tertiary</item>
        <item name="appTextHint">@color/text_hint</item>
        <item name="appAccentMuted">@color/glass_accent</item>
        <item name="appWindowBackground">@drawable/bg_window_midnight</item>

        <!--
          Material tints elevated surfaces toward the primary colour, which is
          what gave every raised card a lavender cast over the surface colour
          the theme actually specifies. Disabling the overlay makes cards
          render exactly the colour the active theme asks for, which is what
          keeps the palettes looking crisp rather than washed out.
        -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- Primary colors -->
        <item name="colorPrimary">@color/indigo_600</item>
        <item name="colorPrimaryVariant">@color/indigo_500</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/cyan_500</item>
        <item name="colorSecondaryVariant">@color/cyan_400</item>
        <item name="colorOnSecondary">@color/slate_900</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/card_elevated</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/card_border</item>

        <!-- Status bar and navigation -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Material Components -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
        <item name="materialCardViewStyle">@style/Widget.App.CardView</item>
        <item name="alertDialogTheme">@style/Theme.App.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.App.AlertDialog</item>
    </style>

    <!-- Light Theme Variant -->
    <style name="Theme.EmbeddedSystemsCareerGuide.Light" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/indigo_600</item>
        <item name="colorPrimaryVariant">@color/indigo_500</item>
        <item name="colorOnPrimary">@color/slate_100</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/cyan_600</item>
        <item name="colorSecondaryVariant">@color/cyan_500</item>
        <item name="colorOnSecondary">@color/slate_100</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/light_background</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnBackground">@color/light_text_primary</item>
        <item name="colorOnSurface">@color/light_text_primary</item>

        <!-- Status bar and navigation -->
        <item name="android:statusBarColor">@color/slate_50</item>
        <item name="android:navigationBarColor">@color/slate_50</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/light_text_primary</item>
        <item name="android:textColorSecondary">@color/light_text_secondary</item>
    </style>

    <!-- Custom Button Style -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/indigo_600</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:elevation">8dp</item>
        <item name="rippleColor">@color/ripple_color</item>
    </style>

    <!-- Custom TextInputLayout Style -->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/indigo_400</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">3dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/slate_300</item>
        <item name="android:textColorHint">@color/slate_400</item>
        <item name="helperTextTextColor">@color/slate_400</item>
        <item name="errorTextColor">@color/red_400</item>
        <item name="endIconTint">@color/slate_400</item>
        <item name="startIconTint">@color/indigo_400</item>
    </style>

    <!-- Custom CardView Style -->
    <style name="Widget.App.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/ripple_color</item>
    </style>

    <!-- Assessment Specific Styles -->
    <style name="Theme.Assessment" parent="Theme.EmbeddedSystemsCareerGuide">
        <item name="android:windowBackground">@color/slate_900</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Learning Path Specific Styles -->
    <style name="Theme.LearningPath" parent="Theme.EmbeddedSystemsCareerGuide">
        <item name="android:windowBackground">@color/slate_900</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Dark AlertDialog Style -->
    <style name="Theme.App.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@color/slate_800</item>
        <item name="android:textColor">@color/slate_100</item>
        <item name="android:textColorPrimary">@color/slate_100</item>
        <item name="android:textColorSecondary">@color/slate_400</item>
        <item name="colorSurface">@color/slate_800</item>
        <item name="colorOnSurface">@color/slate_100</item>
        <item name="colorOnSurfaceVariant">@color/slate_300</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Title.Dark</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.Body.Dark</item>
    </style>

    <style name="MaterialAlertDialog.Title.Dark" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/slate_100</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="MaterialAlertDialog.Body.Dark" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/slate_300</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!--
      AppBar and Popup Overlays.

      These MUST be declared in the default (non-night) bucket, not only in
      values-night/. layout-w600dp/app_bar_main.xml and
      layout-w1240dp/app_bar_main.xml reference them, so on any screen at least
      600dp wide with the system in light mode the default configuration had no
      entry for these style ids and inflating activity_main threw
      Resources.NotFoundException: a hard crash on tablets, unfolded foldables,
      and large phones in landscape.

      Dark parents match the (currently dark) default theme above, so behaviour
      is unchanged on phones. values-night/themes.xml overrides these for night.
    -->
    <style name="Theme.EmbeddedSystemsCareerGuide.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />
    <style name="Theme.EmbeddedSystemsCareerGuide.PopupOverlay" parent="ThemeOverlay.Material3.Dark" />

</resources>

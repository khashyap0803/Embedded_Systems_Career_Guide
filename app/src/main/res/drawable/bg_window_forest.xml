<?xml version="1.0" encoding="utf-8"?>
<!--
  Window backdrop for the Forest theme.

  The colours are literal rather than ?attr/ references: a <gradient> inside a
  <shape> does not reliably resolve theme attributes against the *applied*
  theme, so a single shared drawable rendered the default palette on every
  theme. Each theme points appWindowBackground at its own copy instead, which
  the View resolves at inflation.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="135"
        android:startColor="#061109"
        android:centerColor="#061109"
        android:endColor="#0C1F14"
        android:type="linear" />
</shape>
